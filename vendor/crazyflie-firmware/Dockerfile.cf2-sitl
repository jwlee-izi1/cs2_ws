FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        python3 \
        python3-pip \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir Jinja2

WORKDIR /firmware
COPY . /firmware

# Clean any host-side build artifacts and rebuild for the 22.04 toolchain
RUN cd sitl_make \
    && rm -rf build \
    && mkdir build \
    && cd build \
    && cmake .. \
    && make cf2 -j$(nproc)

ENTRYPOINT ["/firmware/sitl_make/build/cf2"]
