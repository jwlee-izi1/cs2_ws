+    def _broadcast_peer_positions(self):
+        """Tell each Crazyflie where its neighbors are, so the on-board
+        collision-avoidance (BVC) module has peer positions to work with.
+
+        Sends each drone ONLY its peers (its own position already comes from its
+        estimator). Peers are tagged with a distinct id (1..N) that never equals
+        the firmware my_id, so a drone never mistakes itself for a neighbor.
+        """
+        for uri in self.uris:
+            name = self.cf_dict[uri]
+            peers = [(self._peer_id[other], px, py, pz)
+                     for other, (px, py, pz) in self._peer_latest_pos.items()
+                     if other != name]
+            if not peers:
+                continue
+            try:
+                self.swarm._cfs[uri].cf.loc.send_extpos_packed(peers)
+            except Exception:
+                pass
+
