+        # --- BVC peer-position broadcast (feeds on-board collision avoidance) ---
+        # When peer_broadcast_hz > 0 (set under `all:` in the crazyflies yaml) the
+        # server periodically tells each Crazyflie where its neighbors are via a
+        # packed EXT_POSITION_PACKED CRTP packet. Without this, the firmware's
+        # collision avoidance (BVC) sees no neighbors (nOthers=0) and does nothing.
+        self._peer_broadcast_hz = float(
+            self._ros_parameters.get('all', {}).get('peer_broadcast_hz', 0.0))
+        self._peer_latest_pos = {}   # cf_name -> (x, y, z)
+        # Peer id = the byte the firmware compares against its own my_id. SITL gives
+        # every drone the same my_id (0xE7), so we assign distinct ids 1..N (never
+        # 0xE7) and send each drone ONLY its peers, so a drone is never its own peer.
+        self._peer_id = {self.cf_dict[u]: i + 1 for i, u in enumerate(self.uris)}
+
         # Setup Swarm class cflib with connection callbacks and open the links
